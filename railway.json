{
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": {
            "steps": [
                "composer install --no-dev",
                "npm ci",
                "npm run build"
            ]
        }
    },
    "deploy": {
        "startCommand": "composer railway && php artisan serve --host=0.0.0.0 --port=$PORT",
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE"
    }
}
